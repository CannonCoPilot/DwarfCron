{
  "id": "X8s1",
  "description": "One entry per species (sw d1e198a, user 15 Oct) against the same engine with it off, on two forts as built at embark: the small savage lake (V75_SMALLSAV, straddles 3 region tiles: the case the TR2 measurement says matters most) and the good coast (V75_GOOD, 1 site tile, 6 draw tiles). Spring to the end of autumn, one replicate per arm. Expect with it on: no species with more than one open surface entry; walkers' share of land waves up and fliers' and DF-multi-stocked species' (kakapo on 6 tiles, ravens) down; cast coverage up on the ground; in-cast odds then follow FREQUENCY alone (the ladder's spread stays: fix 2, on hold).",
  "needs": "sw-wt/plugin d1e198a scripts deployed; V75_SMALLSAV, V75_GOOD .preverify",
  "reps": 1,
  "until": "season:3",
  "chunk": 20000,
  "pairs_every": 3000,
  "save_chunks": true,
  "sustain": true,
  "recorder": true,
  "ledger_live": true,
  "perf": true,
  "state_every_chunk": true,
  "restart_each_cell": true,
  "receipts": [
    {
      "cmd": "seasonal-wildlife cast status",
      "expect": "season casts on",
      "name": "casts on"
    },
    {
      "cmd": "seasonal-wildlife cast status",
      "expect": "^\\s+ground\\s+Summer\\s+\\d+\\+\\d+\\s+seed",
      "name": "v7.5 casts: a land-ground cast for summer"
    },
    {
      "cmd": "seasonal-wildlife cast status",
      "expect": "^\\s+flying\\s+Summer\\s+\\d+\\+\\d+\\s+seed",
      "name": "a land-flying cast for summer"
    },
    {
      "cmd": "seasonal-wildlife cast status",
      "expect": "^\\s+cavern1\\s+Summer\\s+\\d+\\+\\d+\\s+seed",
      "name": "a cavern-1 cast for summer"
    },
    {
      "cmd": "seasonal-wildlife cast extinct",
      "expect": "cast extinct: \\w+",
      "name": "the world's extinct rule"
    },
    {
      "cmd": "seasonal-wildlife caverns",
      "expect": "cavern map",
      "check": "depth \\d \\(cave",
      "name": "an open cavern (for the depth audit)"
    },
    {
      "lua": "local c = reqscript('seasonal-wildlife').loadConfig(); for _, r in ipairs(c.fp_created or {}) do local d = -1; if r.kind == 'cave' then d = df.global.world.world_data.underground_regions[r.cave].layer_depth end; print(('fp_created %s %s %d'):format(r.kind, r.token, d)) end; print('fp_created total ' .. #(c.fp_created or {}))",
      "expect": "fp_created total",
      "check": "fp_created total [1-9]",
      "name": "population entries created for unstocked cast species"
    },
    {
      "cmd": "seasonal-wildlife sponges",
      "expect": "sponges",
      "name": "sponge line (giant sponges allowed or not)"
    },
    {
      "cmd": "seasonal-wildlife status",
      "expect": "^Layers: .*land",
      "name": "the tool runs the land layer"
    },
    {
      "cmd": "seasonal-wildlife groups pause",
      "expect": "land pause",
      "check": "land pause: on.*reopens 2 group",
      "name": "land pause on, margin 2"
    },
    {
      "cmd": "seasonal-wildlife groups cavern",
      "expect": "groups: cavern",
      "check": "pause on",
      "name": "cavern pause on"
    }
  ],
  "arms": [
    {
      "name": "S0",
      "fort": "V75_SMALLSAV",
      "pre": [
        "seasonal-wildlife groups single off"
      ],
      "receipts": [
        {
          "cmd": "seasonal-wildlife groups single",
          "expect": "one entry per species",
          "check": "one entry per species: off",
          "name": "one entry per species off"
        }
      ]
    },
