{
  "id": "X7v75b",
  "description": "Continuation of X7v75 (same spec, same engine 414d494 + plugin 37baf8d) for the forts that never ran: the lost evil coast left DF in its Options menu and the runner failed G and S on the quit (runner fixed: a failed quit restarts DF). Arms G S U J T.",
  "needs": "sw-wt/plugin v7.5-fullpool 414d494 scripts deployed; seasonal-wildlife.plug.dll 37baf8d installed; recorder with kind 'undead'; .preverify backups",
  "reps": 1,
  "until": "season:4+20000",
  "chunk": 20000,
  "pairs_every": 3000,
  "save_chunks": true,
  "sustain": true,
  "recorder": true,
  "ledger_live": true,
  "perf": true,
  "state_every_chunk": true,
  "restart_each_cell": true,
  "receipts": [
    {
      "cmd": "seasonal-wildlife cast status",
      "expect": "season casts on",
      "name": "casts on"
    },
    {
      "cmd": "seasonal-wildlife cast status",
      "expect": "^\\s+ground\\s+Summer\\s+\\d+\\+\\d+\\s+seed",
      "name": "v7.5 casts: a land-ground cast for summer"
    },
    {
      "cmd": "seasonal-wildlife cast status",
      "expect": "^\\s+flying\\s+Summer\\s+\\d+\\+\\d+\\s+seed",
      "name": "a land-flying cast for summer"
    },
    {
      "cmd": "seasonal-wildlife cast status",
      "expect": "^\\s+cavern1\\s+Summer\\s+\\d+\\+\\d+\\s+seed",
      "name": "a cavern-1 cast for summer"
    },
    {
      "cmd": "seasonal-wildlife cast extinct",
      "expect": "cast extinct: \\w+",
      "name": "the world's extinct rule"
    },
    {
      "cmd": "seasonal-wildlife caverns",
      "expect": "cavern map",
      "check": "depth \\d \\(cave",
      "name": "an open cavern (for the depth audit)"
    },
    {
      "lua": "local c = reqscript('seasonal-wildlife').loadConfig(); for _, r in ipairs(c.fp_created or {}) do local d = -1; if r.kind == 'cave' then d = df.global.world.world_data.underground_regions[r.cave].layer_depth end; print(('fp_created %s %s %d'):format(r.kind, r.token, d)) end; print('fp_created total ' .. #(c.fp_created or {}))",
      "expect": "fp_created total",
      "check": "fp_created total [1-9]",
      "name": "population entries created for unstocked cast species"
    },
    {
      "cmd": "seasonal-wildlife sponges",
      "expect": "sponges",
      "name": "sponge line (giant sponges allowed or not)"
    },
    {
      "cmd": "seasonal-wildlife status",
      "expect": "^Layers: .*land",
      "name": "the tool runs the land layer"
    },
    {
      "cmd": "seasonal-wildlife groups pause",
      "expect": "land pause",
      "check": "land pause: on.*reopens 2 group",
      "name": "land pause on, margin 2"
    },
    {
      "cmd": "seasonal-wildlife groups cavern",
      "expect": "groups: cavern",
      "check": "pause on",
      "name": "cavern pause on"
    }
  ],
  "arms": [
    {
      "name": "G",
      "fort": "V75_GOOD",
      "receipts": [
        {
          "cmd": "seasonal-wildlife water bodies",
          "expect": "water bodies",
          "check": "ocean [1-9]",
          "name": "the ocean is on the map (soft: may be frozen at embark)"
        },
        {
          "cmd": "seasonal-wildlife cast fort",
          "expect": "cast fort",
          "check": "good\\)",
          "name": "a good biome"
        }
      ]
    },
    {
      "name": "S",
      "fort": "V75_SMALLSAV",
      "receipts": [
        {
          "cmd": "seasonal-wildlife water bodies",
          "expect": "water bodies",
          "check": "lake [1-9]",
          "name": "the lake is on the map (soft: may be frozen at embark)"
        },
        {
          "cmd": "seasonal-wildlife cast pool CENOZOIC_MAMMOTH_PYGMY",
          "expect": "cast pool",
          "check": "CENOZOIC_MAMMOTH_PYGMY .*layers",
          "name": "an extinct species under ISOLATED (small region)"
        }
      ]
    },
    {
      "name": "U",
      "fort": "V75_UNTAMED",
      "receipts": [
        {
          "cmd": "seasonal-wildlife water bodies",
          "expect": "water bodies",
          "check": "lake [1-9]",
          "name": "the lake is on the map (soft: may be frozen at embark)"
        },
        {
          "cmd": "seasonal-wildlife cast extinct",
          "expect": "UNTAMED_WILDS",
          "name": "extinct rule untamed wilds"
        }
      ]
    },
    {
      "name": "J",
      "fort": "V75_JOYOUS",
      "receipts": [
        {
          "cmd": "seasonal-wildlife water bodies",
          "expect": "water bodies",
          "check": "ocean [1-9]",
          "name": "the ocean is on the map (soft: may be frozen at embark)"
        },
        {
          "cmd": "seasonal-wildlife cast fort",
          "expect": "cast fort",
          "check": "savage, good",
          "name": "savage and good"
        }
      ]
    },
    {
      "name": "T",
      "fort": "V75_TERROR",
      "receipts": [
        {
          "cmd": "seasonal-wildlife water bodies",
          "expect": "water bodies",
          "check": "ocean [1-9]",
          "name": "the ocean is on the map (soft: may be frozen at embark)"
        },
        {
          "cmd": "seasonal-wildlife cast fort",
          "expect": "cast fort",
          "check": "wired: NIGHTWING",
          "name": "the nightwing on the evil desert"
        }
      ]
    }
  ]
}