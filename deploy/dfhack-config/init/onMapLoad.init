# This file runs when a map is loaded in adventure or fort mode, after any
# onLoad.init files (which run earlier, when the world is loaded).
#
# Chronicler: Enable RemoteFortressReader for remote polling access
# Provides: GetWorldMap (game time), GetCreatureRaws (race names),
#           GetBuildingDefList, GetReports, etc.
enable remotefortressreader
