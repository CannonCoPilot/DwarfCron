{
  "id": "E10",
  "title": "Piggy-back predation, the full loop: prey arrive, release their hold, exclude the pool to wolf, cougar and dingo, wait, restore",
  "fork": "kills P1 as a mechanism",
  "fort": "CTRL",
  "backup": "CTRL.preverify",
  "fps": 1000,
  "sample_every": 200,
  "tick_budget": 30000,
  "tool_must_be": {
    "enabled": 0,
    "groups_enabled": 0,
    "scheduled": 0
  },
  "predictions": [
    {
      "model": "mechanism works",
      "expects": "arm loop: a wolf, cougar or dingo wave within ~500 ticks of the release with the prey still present; arm no_exclude: a wave of a random species; arm no_release: nothing while two or more prey stay held"
    },
    {
      "model": "exclusion window too short or draw cadence longer",
      "expects": "arm loop: nothing within 3,000 ticks, then a random species after the restore"
    },
    {
      "model": "predators never drawn",
      "expects": "arm loop: nothing in 3,000 ticks and a random species after restore, in every replicate, while E8 showed emu draws under the same exclusion"
    }
  ],
  "kill_criterion": "arm loop must produce a predator wave with prey present in at least three of five replicates; arm no_release must produce nothing before the restore in at least two of three",
