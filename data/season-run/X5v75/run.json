{
 "id": "X5v75",
 "spec": {
  "id": "X5v75",
  "description": "Full-year season audit of the six region-type forts on v7.5 with the 13 Oct apex rules (biome additions, narrowed dingo, giant bug apexes, tigerfish/anaconda, nightwing, apex pack x1.5) and the ISOLATED extinct fix: good, evil, small-savage, untamed-wilds, joyous-wilds and terrifying forts (region16 = region10's terrain, region19), spring -> next spring +20,000 ticks, 1 replicate, DF restarted per fort. Measured as X4v75b, plus the savage/evil content: giants, animal people, extinct species, wired evil apexes, giant bug apexes on the map.",
  "needs": "sw-wt/plugin v7.5-fullpool 0c6453b deployed; V75_* backups .preverify",
  "reps": 1,
  "until": "season:4+20000",
  "chunk": 20000,
  "pairs_every": 3000,
  "save_chunks": true,
  "sustain": true,
  "recorder": true,
  "ledger_live": true,
  "perf": true,
  "state_every_chunk": true,
  "restart_each_cell": true,
  "receipts": [
   {
    "cmd": "seasonal-wildlife cast status",
    "expect": "season casts on",
    "name": "casts on"
   },
   {
    "cmd": "seasonal-wildlife cast status",
    "expect": "^\\s+ground\\s+Summer\\s+\\d+\\+\\d+\\s+seed",
    "name": "v7.5 casts: a land-ground cast for summer"
   },
   {
    "cmd": "seasonal-wildlife cast status",
    "expect": "^\\s+flying\\s+Summer\\s+\\d+\\+\\d+\\s+seed",
    "name": "a land-flying cast for summer"
   },
   {
    "cmd": "seasonal-wildlife cast status",
    "expect": "^\\s+cavern1\\s+Summer\\s+\\d+\\+\\d+\\s+seed",
    "name": "a cavern-1 cast for summer"
   },
   {
    "cmd": "seasonal-wildlife cast extinct",
    "expect": "cast extinct: \\w+",
    "name": "the world's extinct rule"
   },
   {
    "cmd": "seasonal-wildlife caverns",
    "expect": "cavern map",
    "check": "depth \\d \\(cave",
    "name": "an open cavern (for the depth audit)"
   },
   {
    "lua": "local c = reqscript('seasonal-wildlife').loadConfig(); for _, r in ipairs(c.fp_created or {}) do local d = -1; if r.kind == 'cave' then d = df.global.world.world_data.underground_regions[r.cave].layer_depth end; print(('fp_created %s %s %d'):format(r.kind, r.token, d)) end; print('fp_created total ' .. #(c.fp_created or {}))",
    "expect": "fp_created total",
    "check": "fp_created total [1-9]",
    "name": "population entries created for unstocked cast species"
   },
   {
    "cmd": "seasonal-wildlife sponges",
    "expect": "sponges",
    "name": "sponge line (giant sponges allowed or not)"
   },
   {
    "cmd": "seasonal-wildlife status",
    "expect": "^Layers: .*land",
    "name": "the tool runs the land layer"
   }
  ],
  "arms": [
   {
    "name": "G",
    "fort": "V75_GOOD",
    "receipts": [
     {
      "cmd": "seasonal-wildlife water bodies",
      "expect": "water bodies",
      "check": "ocean [1-9]",
      "name": "the ocean is on the map (soft: may be frozen at embark)"
     },
     {
      "cmd": "seasonal-wildlife cast fort",
      "expect": "cast fort",
      "check": "good\\)",
      "name": "a good biome"
     }
    ]
   },
   {
    "name": "E",
    "fort": "V75_EVIL",
    "receipts": [
     {
      "cmd": "seasonal-wildlife water bodies",
      "expect": "water bodies",
      "check": "ocean [1-9]",
      "name": "the ocean is on the map (soft: may be frozen at embark)"
     },
     {
      "cmd": "seasonal-wildlife cast fort",
      "expect": "cast fort",
      "check": "wired: HARPY",
      "name": "the harpy wired"
     },
     {
      "cmd": "seasonal-wildlife cast pool GIANT_MANTIS",
      "expect": "cast pool",
      "check": "GIANT_MANTIS .*layers",
      "name": "a giant bug apex on calm evil land"
     }
    ]
   },
   {
    "name": "S",
    "fort": "V75_SMALLSAV",
    "receipts": [
     {
