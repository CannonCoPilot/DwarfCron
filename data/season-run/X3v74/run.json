    "expect": "^\\s+land\\s+Summer\\s+\\d+\\+\\d+\\s+seed",
    "name": "a land cast for summer"
   },
   {
    "cmd": "seasonal-wildlife cast status",
    "expect": "^\\s+cavern\\s+Summer\\s+\\d+\\+\\d+\\s+seed",
    "name": "a cavern cast for summer"
   },
   {
    "cmd": "seasonal-wildlife status",
    "expect": "^Layers: .*land",
    "name": "the tool runs the land layer"
   }
  ],
