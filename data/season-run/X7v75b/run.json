      "name": "the ocean is on the map (soft: may be frozen at embark)"
     },
     {
      "cmd": "seasonal-wildlife cast fort",
      "expect": "cast fort",
      "check": "good\\)",
      "name": "a good biome"
     }
    ]
   },
