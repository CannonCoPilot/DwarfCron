agitated_roster_closed | 1 | +0 | local sw=reqscript('seasonal-wildlife'); local cfg=sw.loadConfig(); if not cfg.initialized then sw.captureDefault(cfg) end; cfg.layers.land=true; cfg.layers.water=false; cfg.layers.cavern=false; local pool=sw.buildPool(cfg); local cands={}; for _,e in ipairs(pool) do if e.inEmbark and sw.defaultAllow(e) then cfg.allow[e.key]=true; if e.layer=='land' and not e.gameVermin then cands[#cands+1]=e end end end; local a=sw.assignFromMatrix(cfg,pool); table.sort(cands,function(x,y) return x.quantity>y.quantity end); local keep={}; local kept={}; for i=1,math.min(3,#cands) do keep[cands[i].key]=true; kept[#kept+1]=cands[i].token..'('..cands[i].quantity..')' end; local closed=0; for _,e in ipairs(pool) do if e.inEmbark and e.layer=='land' and not keep[e.key] then cfg.allow[e.key]=false; closed=closed+1 end end; cfg.groups.enabled=true; cfg.groups.coupling=false; cfg.ecology.enabled=false; sw.saveConfig(cfg); local act=sw.applyLive(cfg, df.global.cur_season); sw.saveConfig(cfg); sw.enableSched(); print(('e23: roster closed - %d assigned, %d land entries closed, %d left open, kept %s'):format(a,closed,act,table.concat(kept,'+'))) | e23: roster closed - 222 assigned, 220 land entries closed, 9 left open, kept BIRD_RAVEN(269)+GIANT_GRAY_LANGUR(34)+GIANT_MANTIS(29)
